    {
      "nome": "Processador",
      "faz": "perto de 100%: algum processo está trabalhando demais (ou travou)"
    },
    {
      "nome": "Memória",
      "faz": "acima de 90%: o disco vira memória virtual e tudo fica lento"
    },
    {
      "nome": "Disco",
      "faz": "cheio: apague o que é grande e tem cópia ou não faz falta"
    },
    {
      "nome": "Encerrar",
      "faz": "libera memória e processador; o que não foi salvo se perde"
    },
    {
      "nome": "Detalhes",
      "faz": "o local do arquivo do processo; os do sistema moram na pasta do sistema"
    }
  ],
  "fazDeVerdade": {
    "titulo": "Agora faça de verdade",
    "texto": "O seu computador tem o mesmo painel.",
    "passos": [
      "Abra o Gerenciador de Tarefas (Ctrl+Shift+Esc no Windows), o Monitor de Atividade (macOS) ou o comando `top` no Linux.",
      "Ordene os processos por memória e depois por processador. Quem está no topo?",
      "Antes de encerrar qualquer coisa de verdade, salve o seu trabalho e não mexa em processos do sistema."
    ]
  },

{
  "id": "laboratorio-de-rede",
  "nome": "Laboratório de Rede",
  "versao": 1,
  "tipo": "rede-terminal",
  "descricao": "Uma rede com defeito e um terminal simulado: investigue com ipconfig, ping, traceroute, nslookup e nc e diga onde está o problema.",
  "tituloReferencia": "Comandos do terminal",
  "rotuloBancada": "Terminal e conclusão",
  "referencia": [
    {
      "nome": "ipconfig",
      "faz": "mostra o IP, a máscara, o gateway e o DNS deste computador"
    },
    {
      "nome": "ping <destino>",
      "faz": "manda 4 ecos e mede a volta (ms) e a perda"
    },
    {
      "nome": "traceroute <destino>",
      "faz": "lista cada salto do caminho (tracert no Windows)"
    },
    {
      "nome": "nslookup <nome> [servidor]",
      "faz": "pergunta o IP ao DNS (ou a outro servidor DNS)"
    },
    {
      "nome": "nc -zv <destino> <porta>",
      "faz": "testa se a porta aceita conexão"
    },
    {
      "nome": "limpar",
      "faz": "limpa a tela"
    }
  ],
  "fazDeVerdade": {
    "titulo": "Agora faça de verdade",
    "texto": "Os mesmos comandos estão no seu computador.",
    "passos": [
      "Abra o terminal (Prompt de Comando no Windows) e rode `ping` no seu roteador e num site conhecido. Compare os tempos.",
      "Rode `tracert` (Windows) ou `traceroute` (Linux e macOS) até o mesmo site e conte os saltos.",
      "Rode `nslookup` com o nome de um site e depois com o mesmo nome e o servidor 1.1.1.1 no fim."
    ]
  },

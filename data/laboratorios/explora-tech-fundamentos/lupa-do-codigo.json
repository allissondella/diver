      "codigo": "temperatura = 24\nif temperatura >= 30:\n    roupa = \"bermuda\"\nelif temperatura >= 20:\n    roupa = \"camiseta\"\nelse:\n    roupa = \"casaco\"\nprint(\"Hoje:\", roupa)\n",
